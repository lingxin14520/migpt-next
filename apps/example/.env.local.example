# 复制这个文件为 .env.local，把你的密钥填进去（.env.local 已被 .gitignore 忽略，不会提交）

# 大模型接口（任何兼容 OpenAI 接口的服务都可以，默认 DeepSeek）
MIGPT_BASE_URL=https://api.deepseek.com/v1
MIGPT_API_KEY=sk-你的密钥
MIGPT_MODEL=deepseek-chat

# 小爱音箱（did 填米家里显示的音箱名称；userId 是纯数字的小米 ID）
MIGPT_SPEAKER_DID=Xiaomi 智能音箱 Pro
MIGPT_USER_ID=1234567

# 二选一：优先用 passToken，用密码登录容易触发人机校验
MIGPT_PASS_TOKEN=
MIGPT_PASSWORD=
